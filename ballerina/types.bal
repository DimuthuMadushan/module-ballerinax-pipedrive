    # The title of the deal
    string title?;
    # The last updated date and time of the deal
    @jsondata:Name {value: "update_time"}
    string? updateTime?;
    # Whether the deal is deleted or not
    @jsondata:Name {value: "is_deleted"}
    boolean isDeleted?;
    # Only available in Growth and above plans
    # 
    # The Annual Contract Value of the deal
    # 
    # Null if there are no products attached to the deal
    decimal? acv?;
    # The ID of the pipeline associated with the deal
    @jsondata:Name {value: "pipeline_id"}
    int pipelineId?;
    # The date and time of changing the deal status as lost
    @jsondata:Name {value: "lost_time"}
    string? lostTime?;
    # The currency associated with the deal
    string currency?;
    # The ID of the deal
    int id?;
    # The value of the deal
    decimal value?;
    # The ID of the person linked to the deal
    @jsondata:Name {value: "person_id"}
    int? personId?;
    # Only available in Growth and above plans
    # 
    # The Annual Recurring Revenue of the deal
    # 
    # Null if there are no products attached to the deal
    decimal? arr?;
    # The expected close date of the deal
    @jsondata:Name {value: "expected_close_date"}
    string? expectedCloseDate?;
    # The ID of the deal stage
    @jsondata:Name {value: "stage_id"}
    int stageId?;
    # The success probability percentage of the deal
    decimal? probability?;
    # The IDs of labels assigned to the deal
    @jsondata:Name {value: "label_ids"}
    int[] labelIds?;
    # An object where each key represents a custom field. All custom fields are referenced as randomly generated 40-character hashes. To clear a custom field value, set it to `null`. For multi-option fields (field type `set`), use `null` to clear the selection — sending an empty array `[]` is not supported and will result in a validation error
    @jsondata:Name {value: "custom_fields"}
    record {} customFields?;
    # The date and time of closing the deal
    @jsondata:Name {value: "close_time"}
    string? closeTime?;
    # Only available in Growth and above plans
    # 
    # The Monthly Recurring Revenue of the deal
    # 
    # Null if there are no products attached to the deal
    decimal? mrr?;
    # The reason for losing the deal
    @jsondata:Name {value: "lost_reason"}
    string? lostReason?;
    # The date and time of changing the deal status as won
    @jsondata:Name {value: "won_time"}
    string? wonTime?;
    # Whether the deal is archived or not
    @jsondata:Name {value: "is_archived"}
    boolean isArchived?;
    # The visibility of the deal
    @jsondata:Name {value: "visible_to"}
    int visibleTo?;
    # The ID of the organization linked to the deal
    @jsondata:Name {value: "org_id"}
    int? orgId?;
    # The last updated date and time of the deal stage
    @jsondata:Name {value: "stage_change_time"}
    string? stageChangeTime?;
    # The creation date and time of the deal
    @jsondata:Name {value: "add_time"}
    string addTime?;
    # The optional ID to further distinguish the Marketing channel
    @jsondata:Name {value: "channel_id"}
    string? channelId?;
    # The status of the deal
