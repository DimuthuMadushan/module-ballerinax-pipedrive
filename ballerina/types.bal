    int phaseId?;
    # An array of IDs of the deals this project is associated with
    @jsondata:Name {value: "deal_ids"}
    int[] dealIds?;
    # The date and time the project was archived in ISO 8601 format. If not archived, this field is null
    @jsondata:Name {value: "archive_time"}
    string? archiveTime?;
    # The title of the project
    string title?;
    # The last updated date and time of the project in ISO 8601 format
    @jsondata:Name {value: "update_time"}
    string updateTime?;
    # The date and time of the last status change of the project in ISO 8601 format
    @jsondata:Name {value: "status_change_time"}
    string statusChangeTime?;
    # The ID of the board this project is associated with
    @jsondata:Name {value: "board_id"}
    int boardId?;
    # An array of IDs of the persons this project is associated with
    @jsondata:Name {value: "person_ids"}
    int[] personIds?;
    # The ID of the project
    int id?;
    # The health status of the project
    @jsondata:Name {value: "health_status"}
    int? healthStatus?;
    # The creation date and time of the project in ISO 8601 format
    @jsondata:Name {value: "add_time"}
    string addTime?;
    # The status of the project
    string status?;
    # The start date of the project. Format: YYYY-MM-DD
