    @http:Query {name: "organization_id"}
    int organizationId?;
    # For pagination, the limit of entries to be returned. If not provided, 100 items will be returned. Please note that a maximum value of 500 is allowed
    int 'limit?;
    # The search term to look for. Minimum 2 characters (or 1 if using `exact_match`). Please note that the search term has to be URL encoded
    string term;
    # Supports including optional fields in the results which are not provided by default
    @http:Query {name: "include_fields"}
    ("lead.was_seen")[] includeFields?;
    # A comma-separated string array. The fields to perform the search from. Defaults to all of them
    ("custom_fields"|"notes"|"title")[] fields?;
    # Will filter leads by the provided person ID. The upper limit of found leads associated with the person is 2000
    @http:Query {name: "person_id"}
    int personId?;
};

