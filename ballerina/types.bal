    ("next_activity_id"|"last_activity_id"|"first_won_time"|"products_count"|"files_count"|"notes_count"|"followers_count"|"email_messages_count"|"activities_count"|"done_activities_count"|"undone_activities_count"|"participants_count"|"last_incoming_mail_time"|"last_outgoing_mail_time"|"smart_bcc_email"|"source_lead_id")[] includeFields?;
