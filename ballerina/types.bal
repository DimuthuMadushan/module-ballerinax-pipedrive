# Represents the Queries record for the operation: getPerson
public type GetPersonQueries record {
    # When provided with 'true' value, response will include an array of label objects in the form of '{ id: number, label: string }'
    @http:Query {name: "include_labels"}
    boolean includeLabels?;
    # Optional comma separated string array of custom fields keys to include. If you are only interested in a particular set of custom fields, please use this parameter for faster results and smaller response.<br/>A maximum of 15 keys is allowed
    @http:Query {name: "custom_fields"}
    string[] customFields?;
    # When provided with a 'true' value, single option and multiple option custom fields values contain objects in the form of '{ id: number, label: string }' instead of plain id
    @http:Query {name: "include_option_labels"}
    boolean includeOptionLabels?;
    # Optional comma separated string array of additional fields to include. `marketing_status` and `doi_status` can only be included if the company has marketing app enabled
    @http:Query {name: "include_fields"}
    ("next_activity_id"|"last_activity_id"|"open_deals_count"|"related_open_deals_count"|"closed_deals_count"|"related_closed_deals_count"|"participant_open_deals_count"|"participant_closed_deals_count"|"email_messages_count"|"activities_count"|"done_activities_count"|"undone_activities_count"|"files_count"|"notes_count"|"followers_count"|"won_deals_count"|"related_won_deals_count"|"lost_deals_count"|"related_lost_deals_count"|"last_incoming_mail_time"|"last_outgoing_mail_time"|"marketing_status"|"doi_status"|"smart_bcc_email")[] includeFields?;
};

# Represents the Queries record for the operation: getActivities
public type GetActivitiesQueries record {
    # For pagination, the marker (an opaque string value) representing the first item on the next page
    string cursor?;
    # If supplied, only activities owned by the specified user are returned. If filter_id is provided, this is ignored
    @http:Query {name: "owner_id"}
    int ownerId?;
    # The field to sort by. Supported fields: `id`, `update_time`, `add_time`, `due_date`
    @http:Query {name: "sort_by"}
    "id"|"update_time"|"add_time"|"due_date" sortBy = "id";
    # If supplied, only activities with specified 'done' flag value are returned
    boolean done?;
    # The sorting direction. Supported values: `asc`, `desc`
    @http:Query {name: "sort_direction"}
    "asc"|"desc" sortDirection = "asc";
    # If supplied, only activities matching the specified filter are returned
    @http:Query {name: "filter_id"}
    int filterId?;
    # If supplied, only activities linked to the specified organization are returned. If filter_id is provided, this is ignored
    @http:Query {name: "org_id"}
    int orgId?;
    # If set, only activities with an `update_time` earlier than this time are returned. In RFC3339 format, e.g. 2025-01-01T10:20:00Z
    @http:Query {name: "updated_until"}
    string updatedUntil?;
    # If set, only activities with an `update_time` later than or equal to this time are returned. In RFC3339 format, e.g. 2025-01-01T10:20:00Z
    @http:Query {name: "updated_since"}
    string updatedSince?;
    # For pagination, the limit of entries to be returned. If not provided, 100 items will be returned. Please note that a maximum value of 500 is allowed
    int 'limit?;
    # Optional comma separated string array of up to 100 entity ids to fetch. If filter_id is provided, this is ignored. If any of the requested entities do not exist or are not visible, they are not included in the response
    @constraint:Array {maxLength: 100}
    string[] ids?;
    # Optional comma separated string array of additional fields to include
    @http:Query {name: "include_fields"}
    ("attendees")[] includeFields?;
    # If supplied, only activities linked to the specified deal are returned. If filter_id is provided, this is ignored
    @http:Query {name: "deal_id"}
    int dealId?;
    # If supplied, only activities linked to the specified lead are returned. If filter_id is provided, this is ignored
    @http:Query {name: "lead_id"}
    string leadId?;
    # If supplied, only activities whose primary participant is the given person are returned. If filter_id is provided, this is ignored
    @http:Query {name: "person_id"}
    int personId?;
};

